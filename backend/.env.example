OPENROUTER_API_KEY=
# Use a ":free" model with a free-tier key; paid models answer HTTP 402.
# Confirm the exact ID resolves: some listed ":free" models 404 upstream, which
# silently falls the app back to data-only instead of failing loudly.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Comma-separated list of allowed browser origins.
FRONTEND_ORIGIN=http://localhost:3000
NCBI_EMAIL=researcher@example.com
